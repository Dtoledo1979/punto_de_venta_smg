# Copiar a .env.local (desarrollo) o cargar en Netlify → Site configuration
# → Environment variables. Ambas son PÚBLICAS por diseño (van al navegador):
# la seguridad real está en la RLS y en las funciones del schema pos.
# NUNCA poner acá la service_role / secret key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key del proyecto>
